/// Función de conveniencia para mostrar el diálogo sin tener que
/// escribir showDialog(...) completo cada vez que se necesite.
Future<void> mostrarDialogoExito({
  required BuildContext context,
  required String titulo,
  required String mensaje,
  required String textoBoton,
  required VoidCallback onPressedBoton,
}) {
  return showDialog(
    context: context,
    barrierDismissible: false,
    builder: (context) => DialogoExito(
      titulo: titulo,
      mensaje: mensaje,
      textoBoton: textoBoton,
      onPressedBoton: onPressedBoton,
