import 'package:flutter/material.dart';

class CampoTexto extends StatefulWidget {
  final TextEditingController controller;
  final bool ocultarTexto;
  final TextInputType tipoTeclado;
  final int? maxLength;
  final TextAlign textAlign;
  final String? hintText;
  final double? letterSpacing;
  final double fontSize;

  const CampoTexto({
    super.key,
    required this.controller,
    this.ocultarTexto = false,
    this.tipoTeclado = TextInputType.text,
    this.maxLength,
    this.textAlign = TextAlign.start,
    this.hintText,
    this.letterSpacing,
    this.fontSize = 16,
  });

  @override
  State<CampoTexto> createState() => _CampoTextoState();
}

class _CampoTextoState extends State<CampoTexto> {
  // Este estado SÍ cambia en tiempo real: empieza igual a
  // widget.ocultarTexto y el usuario lo puede alternar tocando el ícono.
  late bool _oculto;

  @override
  void initState() {
    super.initState();
    _oculto = widget.ocultarTexto;
  }

  void _alternarVisibilidad() {
    setState(() {
      _oculto = !_oculto;
    });
  }

  @override
  Widget build(BuildContext context) {
    return TextField(
      controller: widget.controller,
      obscureText: _oculto,
      keyboardType: widget.tipoTeclado,
      maxLength: widget.maxLength,
      textAlign: widget.textAlign,
      style: TextStyle(
        color: Colors.black,
        fontSize: widget.fontSize,
        letterSpacing: widget.letterSpacing,
        fontWeight: widget.letterSpacing != null
            ? FontWeight.bold
            : FontWeight.normal,
      ),
      decoration: InputDecoration(
        counterText: '',
        filled: true,
        fillColor: const Color(0xFFD3D3D3),
        hintText: widget.hintText,
        contentPadding: const EdgeInsets.symmetric(
          horizontal: 16,
          vertical: 14,
        ),
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(16.0),
          borderSide: BorderSide.none,
        ),
        // Solo muestra el ícono de ojo si el campo es de tipo oculto
        // (por ejemplo, contraseña). En un campo normal no aparece.
        suffixIcon: widget.ocultarTexto
            ? IconButton(
                icon: Icon(
                  _oculto ? Icons.visibility_off : Icons.visibility,
                  color: Colors.black54,
                ),
                onPressed: _alternarVisibilidad,
              )
            : null,
      ),
    );
  }
}
</file>

